<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_sign_in_to_back_up_and_restore_your_projects_the_app_works_without_an_account" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_choice_sign_in"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/ui_sign_in"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/accent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_choice_create"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/ui_create_account" />
</LinearLayout>
